# BuildKit reads this file because it sits next to the Dockerfile; paths are relative
# to the build context, the repository root. Only Cargo manifests and sources are needed.

# Build output and VCS
target/
**/target/
.git/
.github/

# Editors and local state
.idea/
.vscode/
.cursor/
**/*.rs.bk
**/*.pdb
**/*.sqlite
**/*.sqlite-wal
**/*.sqlite-shm

# libmpv the player's build script downloads; the proxy does not link it
crates/cinebox-player/mpv-src/

# Android Gradle state and native libraries
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/app/src/main/jniLibs/

# Packaging output and screenshots
.flatpak-builder/
packaging/flatpak/
docs/
dist/

# Local compose settings may hold an operator key
packaging/tmdb-proxy/.env
