# Copy to .env next to compose.yaml and fill in.

# Public name of the proxy. With the caddy profile, its A/AAAA records must point at
# this machine and ports 80 and 443 must be reachable, so that Caddy can get a certificate.
DOMAIN=tmdb.example.com

# Optional operator key: the proxy then sends its own TMDB key and Cinebox users need
# none. Left empty, each user's key is passed through.
TMDB_API_KEY=
