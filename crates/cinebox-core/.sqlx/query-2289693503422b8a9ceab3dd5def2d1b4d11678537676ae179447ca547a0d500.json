  "query": "\n            SELECT kind, id, title, poster_path, year, vote\n            FROM watch_history\n            WHERE ?1 IS NULL\n               OR COALESCE(section, CASE kind WHEN 'tv' THEN 'tv' ELSE 'movies' END) = ?1\n            ORDER BY updated_at DESC, rowid DESC\n            LIMIT ?2\n            ",
